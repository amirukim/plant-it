# Set to "false" once the real API is running — the dashboard switches from mock data to live data
VITE_USE_MOCK=true

# Where the backend API lives.
# Leave empty when the dashboard is served from the same server as the API (recommended).
# Otherwise point it at the Pi, e.g.:
# VITE_API_BASE_URL=http://raspberrypi.local:8000
VITE_API_BASE_URL=
